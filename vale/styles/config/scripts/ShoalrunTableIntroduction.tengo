text := import("text")
matches := []
offset := 0
headers := text.re_find("(?s)^---\\r?\\n.*?\\r?\\n---(?:\\r?\\n|$)", scope, 1)
if headers { offset = headers[0][0].end }
fenced := false
marker := ""
width := 0
heading := -1
headingEnd := 0
candidate := false
for line in text.split_after(text.substr(scope, offset, len(scope)), "\n") {
    trimmed := text.trim_space(line)
    fences := text.re_find("^(`{3,}|~{3,})", trimmed, 1)
    if fences {
        token := fences[0][1].text
        char := text.substr(token, 0, 1)
        if !fenced {
            fenced = true
            marker = char
            width = len(token)
        } else if char == marker && len(token) >= width && text.trim_space(text.substr(trimmed, len(token), len(trimmed))) == "" {
            fenced = false
        }
        heading = -1
        candidate = false
    } else if !fenced {
        if candidate {
            if text.re_match("^\\|?[ \\t]*:?-{3,}:?[ \\t]*(?:\\|[ \\t]*:?-{3,}:?[ \\t]*)*\\|?$", trimmed) {
                matches = append(matches, {begin: heading, end: headingEnd})
            }
            candidate = false
            heading = -1
        }
        if text.re_match("^#{1,6}[ \\t]+\\S", trimmed) {
            heading = offset + text.index(line, "#")
            headingEnd = offset + len(text.trim_suffix(line, "\n"))
        } else if trimmed != "" && heading >= 0 {
            if text.contains(trimmed, "|") { candidate = true } else { heading = -1 }
        }
    }
    offset += len(line)
}
