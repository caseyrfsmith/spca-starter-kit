text := import("text")
matches := []
headers := text.re_find("(?s)^---\\r?\\n(.*?)\\r?\\n---(?:\\r?\\n|$)", scope, 1)
if headers {
    types := text.re_find("(?m)^type:[ \\t]*[\"']?([a-z-]+)", headers[0][1].text, 1)
    if types {
        kind := types[0][1].text
        offset := headers[0][0].end
        fenced := false
        marker := ""
        width := 0
        // Scan headings, not prose. Skip fenced examples, preserving source positions.
        for line in text.split_after(text.substr(scope, offset, len(scope)), "\n") {
            trimmed := text.trim_space(line)
            fences := text.re_find("^(`{3,}|~{3,})", trimmed, 1)
            if fences {
                token := fences[0][1].text
                char := text.substr(token, 0, 1)
                if !fenced {
                    fenced = true
                    marker = char
                    width = len(token)
                } else if char == marker && len(token) >= width && text.trim_space(text.substr(trimmed, len(token), len(trimmed))) == "" {
                    fenced = false
                }
            } else if !fenced && text.has_prefix(trimmed, "## ") {
                heading := text.to_lower(text.trim_space(text.trim_prefix(trimmed, "## ")))
                message := ""
                if (kind == "how-to" || kind == "recipe") && text.re_match("^(reference|options|parameters|fields)$", heading) {
                    message = "Review this task page's reference section. Keep only facts needed for the action; link to complete reference material."
                } else if (kind == "reference" || kind == "api-reference") && text.re_match("^(step [0-9]+[:.]|before you begin$|check your work$|do it$)", heading) {
                    message = "Review this reference section for a task walkthrough. Describe behavior here and link to a how-to or tutorial for the sequence."
                } else if kind == "tutorial" && text.re_match("^(alternatives|tradeoffs(?: and alternatives)?|reference)$", heading) {
                    message = "Review this tutorial digression. Keep one reliable exercise; link out for alternatives, background, and complete reference facts."
                } else if kind == "explanation" && text.re_match("^step [0-9]+[:.]", heading) {
                    message = "Review this explanation section for task instructions. Discuss context and reasons here; link to a how-to for actions."
                }
                if message != "" {
                    start := offset + text.index(line, "## ")
                    matches = append(matches, {begin: start, end: start + len(text.trim_space(line)), message: message})
                }
            }
            offset += len(line)
        }
    }
}
